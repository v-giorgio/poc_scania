# Exemplo de configuração do Databricks Asset Bundle (DAB)
# Documentação: https://docs.databricks.com/dev-tools/bundles/index.html
# Copie, renomeie para databricks.yml e preencha. NUNCA commitar credenciais.

bundle:
  name: poc_scania_michelin

workspace:
  host: https://<workspace>.azuredatabricks.net

resources:
  jobs:
    batch_scoring:
      name: poc-scania-batch-scoring
      tasks:
        - task_key: score
          notebook_task:
            notebook_path: notebooks/06_deployment/01_deployment_concept
          new_cluster:
            spark_version: "14.3.x-scala2.12"
            node_type_id: i3.xlarge
            num_workers: 1
            aws_attributes:
              availability: SPOT_WITH_FALLBACK
