# Copie para .env e preencha com seus valores. NUNCA commitar .env.

# AWS
S3_BUCKET=meu-bucket-poc-scania

# Databricks (para uso via CLI local)
DATABRICKS_HOST=https://<workspace>.azuredatabricks.net
DATABRICKS_TOKEN=

# MLflow (se usar tracking server separado do Databricks)
MLFLOW_TRACKING_URI=databricks
