# Copie para .env e preencha com seus valores. NUNCA commitar .env.

# Exemplo documental; notebooks Databricks usam widgets, não carregam este arquivo.
# Crie o volume gerenciado, faça upload dos oito CSVs em seu subdiretório raw,
# e use o mesmo catalog/schema para as tabelas Delta gerenciadas.
RAW_VOLUME_PATH=/Volumes/<catalog>/<schema>/<volume>/raw
DATA_SCHEMA=<catalog>.<schema>
